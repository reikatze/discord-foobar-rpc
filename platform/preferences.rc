#include <windows.h>
#include "resource.h"
IDD_MUSIC_PREFERENCES DIALOGEX 0,0,300,165
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | DS_CONTROL
CAPTION "discord-foobar-rpc"
FONT 9,"Segoe UI"
BEGIN
    CONTROL "Enable Discord Rich Presence",IDC_ENABLED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,10,270,15
    LTEXT "Custom Discord application ID (optional)",-1,10,35,270,12
    EDITTEXT IDC_APPLICATION_ID,10,50,270,15,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Leave blank to use the built-in application. The built-in ID is not shown or saved in settings.",-1,10,72,275,26
    LTEXT "MusicBrainz supplies missing metadata and cover art. Cached artwork URLs are reused automatically.",-1,10,103,275,26
    LTEXT "",IDC_STATUS,10,139,275,22
END
